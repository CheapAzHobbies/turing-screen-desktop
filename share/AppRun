#!/usr/bin/env bash
# turing-screen-desktop AppImage entry point.
#
# Upstream resolves config.yaml, fonts and themes from Path(__file__).parent.parent,
# so the program insists on writing next to its own source. An AppImage mount is
# read-only, so on first run we build a small writable working tree in the user's
# data dir: code and config are real files, while the ~1 GB of fonts and theme
# assets stay symlinked into the read-only image. A theme is only ever copied for
# real when the user actually edits it.

set -euo pipefail

HERE="$(dirname "$(readlink -f "${0}")")"
SRC="$HERE/opt/turing"
DEPS="$HERE/opt/deps"
PYTHON="$HERE/usr/bin/python3"
WORK="${XDG_DATA_HOME:-$HOME/.local/share}/turing-screen/app"
STAMP="$WORK/.built-from"
VERSION="$(cat "$HERE/opt/VERSION" 2>/dev/null || echo unknown)"

die() {
    if command -v zenity >/dev/null 2>&1; then zenity --error --width=400 --text="$1" 2>/dev/null || true; fi
    printf 'turing-screen: %s\n' "$1" >&2
    exit 1
}

# --- writable working tree ------------------------------------------------
# The image mounts at a fresh /tmp/.mount_XXXXXX on every launch and is
# unmounted on exit, so every symlink into it dies the moment we quit. Asset
# links must therefore be re-pointed on EVERY run, not just when the bundled
# version changes.
sync_code() {
    mkdir -p "$WORK/res"

    # Code must be REAL files: config.py does Path(__file__).parent.parent.resolve(),
    # and .resolve() would follow a symlink straight back into the read-only image.
    rm -rf "$WORK/library"
    cp -r "$SRC/library" "$WORK/library"
    for f in main.py configure.py theme-editor.py simple-program.py; do
        [ -f "$SRC/$f" ] && cp -f "$SRC/$f" "$WORK/$f"
    done

    [ -f "$WORK/config.yaml" ] || cp -f "$SRC/config.yaml" "$WORK/config.yaml"
    echo "$VERSION" > "$STAMP"
}

link_assets() {
    mkdir -p "$WORK/res"

    # Big read-only asset dirs stay in the image.
    for d in fonts backgrounds icons docs; do
        [ -d "$SRC/res/$d" ] || continue
        rm -rf "$WORK/res/$d"
        ln -sfn "$SRC/res/$d" "$WORK/res/$d"
    done

    # Themes: a real directory of per-theme symlinks, so an edited theme can be
    # swapped for a real copy without duplicating the other ~850 MB.
    mkdir -p "$WORK/res/themes"
    [ -f "$SRC/res/themes/default.yaml" ] && cp -f "$SRC/res/themes/default.yaml" "$WORK/res/themes/default.yaml"
    for t in "$SRC"/res/themes/*/; do
        [ -d "$t" ] || continue
        name="$(basename "$t")"
        target="$WORK/res/themes/$name"
        # Never clobber a theme the user has edited into a real directory.
        if [ -d "$target" ] && [ ! -L "$target" ]; then continue; fi
        ln -sfn "$t" "$target"
    done

}

[ -x "$PYTHON" ] || die "Bundled Python is missing from this AppImage."
# Code only needs copying when the bundled version changes...
[ "$(cat "$STAMP" 2>/dev/null || true)" = "$VERSION" ] || sync_code
# ...but asset links must be refreshed every single run, because last run's
# mount point no longer exists.
link_assets

# --- make one theme writable, on demand -----------------------------------
materialize_theme() {
    local name="$1" target="$WORK/res/themes/$1"
    if [ -L "$target" ]; then
        local real; real="$(readlink -f "$target")"
        rm -f "$target"
        cp -rL "$real" "$target"
        chmod -R u+w "$target"
    fi
}

current_theme() {
    sed -n 's/^[[:space:]]*THEME:[[:space:]]*//p' "$WORK/config.yaml" 2>/dev/null | head -1 | tr -d "\"'\r"
}

pick_theme() {
    local current args=() t
    current="$(current_theme)"
    if ! command -v zenity >/dev/null 2>&1; then printf '%s' "$current"; return; fi
    [ -n "$current" ] && args+=(TRUE "$current" "current")
    while IFS= read -r t; do
        [ "$t" = "$current" ] && continue
        args+=(FALSE "$t" "")
    done < <(find "$WORK/res/themes" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null | sort -f)
    [ ${#args[@]} -eq 0 ] && return
    [ -z "$current" ] && args[0]=TRUE
    zenity --list --radiolist --title="Turing Theme Editor" \
        --text="Which theme do you want to edit?" \
        --column="" --column="Theme" --column="" \
        --height=520 --width=460 "${args[@]}" 2>/dev/null || true
}

run() { cd "$WORK"; PYTHONPATH="$DEPS${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON" "$@"; }

case "${1:-}" in
    --config|--configure)
        shift; run configure.py "$@" ;;
    --theme-editor)
        shift
        theme="${1:-}"
        [ -z "$theme" ] && theme="$(pick_theme)"
        [ -z "$theme" ] && exit 0
        materialize_theme "$theme"
        run theme-editor.py "$theme" ;;
    --display|--run)
        shift; run main.py "$@" ;;
    --where)
        echo "image:    $HERE"; echo "workdir:  $WORK"; echo "version:  $VERSION" ;;
    -h|--help)
        cat <<HELP
Turing Smart Screen $VERSION (AppImage)

  (no arguments)      configure on first run, then start the display
  --config            open the configuration wizard
  --theme-editor [T]  edit a theme (asks which, if not given)
  --display           start the display program
  --where             show where settings are stored
  --help              this message

Settings live in $WORK and survive updates to this AppImage.
HELP
        ;;
    "")
        # First run has nothing configured yet, so send people to the wizard.
        if [ ! -f "$WORK/.configured" ]; then
            touch "$WORK/.configured"
            run configure.py
        else
            run main.py
        fi ;;
    *)
        run main.py "$@" ;;
esac
