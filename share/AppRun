#!/usr/bin/env bash
# turing-screen-desktop AppImage entry point.
#
# Clicking the app opens the configuration window - nothing else. That window is
# upstream's own hub: it has "Save and run" to start the display and "Edit theme"
# to open the theme editor, so one entry point reaches everything.
#
# Two constraints shape the rest of this file.
#
# 1. Upstream resolves config.yaml, fonts and themes from
#    Path(__file__).parent.parent.resolve(), so it writes next to its own source,
#    which a read-only AppImage mount forbids. We therefore keep a small writable
#    tree in the user's data dir: code and config are real files, while the ~1 GB
#    of fonts and theme art stays symlinked into the image.
#
# 2. The image mounts at a fresh /tmp/.mount_XXXXXX every launch and is unmounted
#    on exit, so anything pointing into it - symlinks, the interpreter path - must
#    be rewritten on EVERY run, not cached.

set -euo pipefail

HERE="$(dirname "$(readlink -f "${0}")")"
SRC="$HERE/opt/turing"
DEPS="$HERE/opt/deps"
PYTHON="$HERE/usr/bin/python3"
WORK="${XDG_DATA_HOME:-$HOME/.local/share}/turing-screen/app"
STAMP="$WORK/.built-from"
AUTOSTART_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
AUTOSTART_FILE="$AUTOSTART_DIR/turing-smart-screen.desktop"
LAUNCHER="$HOME/.local/bin/turing-smart-screen"
VERSION="$(cat "$HERE/opt/VERSION" 2>/dev/null || echo unknown)"

note() { # note <title> <message>
    if command -v zenity >/dev/null 2>&1; then
        zenity --info --width=380 --title="$1" --text="$2" 2>/dev/null || true
    else
        printf '%s: %s\n' "$1" "$2" >&2
    fi
}

die() { note "Turing Smart Screen" "$1"; exit 1; }

# --- writable working tree -------------------------------------------------

sync_code() {
    mkdir -p "$WORK/res"

    # Code must be REAL files: config.py calls .resolve(), which would follow a
    # symlink straight back into the read-only mount.
    rm -rf "$WORK/library"
    cp -r "$SRC/library" "$WORK/library"

    for f in main.py configure.py theme-editor.py simple-program.py; do
        [ -f "$SRC/$f" ] || continue
        cp -f "$SRC/$f" "$WORK/$f"
        # Upstream ships "#!/usr/bin/env python". Plain `python` does not exist on
        # most distros and would miss the bundled dependencies anyway. The wizard
        # launches main.py and theme-editor.py directly, so the shebang has to
        # work: point it at our shim, which link_assets keeps current.
        sed -i "1s|^#!.*|#!$WORK/.python|" "$WORK/$f"
        chmod +x "$WORK/$f"
    done

    [ -f "$WORK/config.yaml" ] || cp -f "$SRC/config.yaml" "$WORK/config.yaml"
    echo "$VERSION" > "$STAMP"
}

link_assets() {
    mkdir -p "$WORK/res"

    # Stable interpreter entry point, rewritten each launch because the mount
    # path changes. It also enforces one display at a time, which catches the
    # wizard's own "Save and run" as well as our --display flag.
    cat > "$WORK/.python" <<SHIM
#!/bin/sh
# generated by AppRun - do not edit
#
# configure.py launches main.py and theme-editor.py through their shebang, i.e.
# through this file. Those are long-lived windows, but the AppImage that is
# running configure.py unmounts as soon as configure.py exits - which would pull
# the interpreter out from under them. So for those two we relaunch the AppImage
# itself, giving each its own mount for as long as it runs. Everything else runs
# in the current mount.
IMG="$(self_path)"
find_img() {
    [ -x "\$IMG" ] && return 0
    for d in "\$HOME/Applications" "\$HOME/.local/bin" "\$HOME/Downloads" "\$HOME"; do
        [ -d "\$d" ] || continue
        f=\$(ls -t "\$d"/Turing_Smart_Screen*.AppImage 2>/dev/null | head -1)
        [ -n "\$f" ] && { IMG="\$f"; return 0; }
    done
    return 1
}
case "\${1:-}" in
    *main.py)
        if find_img; then exec "\$IMG" --display; fi
        echo "Turing Smart Screen AppImage not found - cannot start the display." >&2
        exit 1 ;;
    *theme-editor.py)
        if find_img; then exec "\$IMG" --theme-editor "\${2:-}"; fi
        echo "Turing Smart Screen AppImage not found - cannot open the theme editor." >&2
        exit 1 ;;
esac
PYTHONPATH="$DEPS\${PYTHONPATH:+:\$PYTHONPATH}"
export PYTHONPATH
exec "$PYTHON" "\$@"
SHIM
    chmod +x "$WORK/.python"

    # Standalone helper for the "Start at login" checkbox inside the config
    # window. Self-contained so the checkbox works without re-mounting the image.
    cat > "$WORK/.autostart-helper" <<HELPER
#!/bin/sh
# generated by AppRun - do not edit
AUTOSTART_FILE="$AUTOSTART_FILE"
LAUNCHER="$LAUNCHER"
IMG="$(self_path)"
case "\${1:-status}" in
  on|enable)
    mkdir -p "\$(dirname "\$AUTOSTART_FILE")" "\$(dirname "\$LAUNCHER")"
    cat > "\$LAUNCHER" <<'INNER'
#!/bin/sh
img="__IMG__"
if [ ! -x "\$img" ]; then
    for d in "\$HOME/Applications" "\$HOME/.local/bin" "\$HOME/Downloads" "\$HOME"; do
        [ -d "\$d" ] || continue
        found=\$(ls -t "\$d"/Turing_Smart_Screen*.AppImage 2>/dev/null | head -1)
        [ -n "\$found" ] && { img="\$found"; break; }
    done
fi
[ -x "\$img" ] || { echo "Turing Smart Screen AppImage not found" >&2; exit 1; }
exec "\$img" --display
INNER
    sed -i "s|__IMG__|\$IMG|" "\$LAUNCHER"
    chmod +x "\$LAUNCHER"
    printf '%s\n' "[Desktop Entry]" "Type=Application" "Name=Turing Smart Screen" \
      "Comment=Start the Turing smart screen display at login" "Exec=\$LAUNCHER" \
      "Icon=turing-smart-screen" "Terminal=false" "X-GNOME-Autostart-enabled=true" \
      > "\$AUTOSTART_FILE"
    echo "enabled" ;;
  off|disable)
    rm -f "\$AUTOSTART_FILE" "\$LAUNCHER"; echo "disabled" ;;
  *)
    [ -f "\$AUTOSTART_FILE" ] && echo "enabled" || echo "disabled" ;;
esac
HELPER
    chmod +x "$WORK/.autostart-helper"

    for d in fonts backgrounds icons docs; do
        [ -d "$SRC/res/$d" ] || continue
        rm -rf "$WORK/res/$d"
        ln -sfn "$SRC/res/$d" "$WORK/res/$d"
    done

    mkdir -p "$WORK/res/themes"
    [ -f "$SRC/res/themes/default.yaml" ] && cp -f "$SRC/res/themes/default.yaml" "$WORK/res/themes/default.yaml"
    for t in "$SRC"/res/themes/*/; do
        [ -d "$t" ] || continue
        name="$(basename "$t")"
        target="$WORK/res/themes/$name"
        # Never clobber a theme the user has edited into a real directory.
        if [ -d "$target" ] && [ ! -L "$target" ]; then continue; fi
        ln -sfn "$t" "$target"
    done
}

self_path() {
    if [ -n "${APPIMAGE:-}" ] && [ -f "$APPIMAGE" ]; then printf '%s' "$APPIMAGE"; return 0; fi
    printf '%s' "$HERE"
}

# --- autostart -------------------------------------------------------------
# The AppImage must be executed to mount itself, so autostart has to reference
# the image file. AppImageLauncher renames images with a content hash, which
# changes on every update, so a bare path would break. We record the current
# path but also glob for the image at boot, and fall back gracefully.

autostart_on() {
    mkdir -p "$AUTOSTART_DIR" "$(dirname "$LAUNCHER")"
    cat > "$LAUNCHER" <<LAUNCH
#!/bin/sh
# generated by the Turing Smart Screen AppImage - finds the image, then runs it.
img="$(self_path)"
if [ ! -x "\$img" ]; then
    # The image was moved, renamed or updated (AppImageLauncher rewrites the
    # filename with a content hash). Take the newest match we can find.
    for d in "\$HOME/Applications" "\$HOME/.local/bin" "\$HOME/Downloads" "\$HOME"; do
        [ -d "\$d" ] || continue
        found=\$(ls -t "\$d"/Turing_Smart_Screen*.AppImage 2>/dev/null | head -1)
        [ -n "\$found" ] && { img="\$found"; break; }
    done
fi
[ -x "\$img" ] || { echo "Turing Smart Screen AppImage not found" >&2; exit 1; }
exec "\$img" --display
LAUNCH
    chmod +x "$LAUNCHER"

    cat > "$AUTOSTART_FILE" <<AUTO
[Desktop Entry]
Type=Application
Name=Turing Smart Screen
Comment=Start the Turing smart screen display at login
Exec=$LAUNCHER
Icon=turing-smart-screen
Terminal=false
X-GNOME-Autostart-enabled=true
AUTO
    [ "${1:-}" = "quiet" ] || note "Run at startup" "The screen will start automatically at startup."
}

autostart_off() {
    rm -f "$AUTOSTART_FILE" "$LAUNCHER"
    [ "${1:-}" = "quiet" ] || note "Run at startup" "The screen will no longer start automatically."
}

autostart_status() {
    if [ -f "$AUTOSTART_FILE" ]; then echo "autostart: enabled ($AUTOSTART_FILE)";
    else echo "autostart: disabled"; fi
}

[ -x "$PYTHON" ] || die "Bundled Python is missing from this AppImage."
[ "$(cat "$STAMP" 2>/dev/null || true)" = "$VERSION" ] || sync_code
link_assets

# Anyone installing this wants the screen running, so autostart is on out of the
# box. Done exactly once and recorded, so unticking the checkbox sticks and is
# never silently re-enabled on a later launch.
if [ ! -f "$WORK/.autostart-defaulted" ]; then
    touch "$WORK/.autostart-defaulted"
    autostart_on quiet >/dev/null 2>&1 || true
fi

# --- helpers ---------------------------------------------------------------

run() { cd "$WORK"; PYTHONPATH="$DEPS${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON" "$@"; }

# Same, but returns instead of replacing this process, so we can follow up.
run_wait() { ( cd "$WORK"; PYTHONPATH="$DEPS${PYTHONPATH:+:$PYTHONPATH}" TURING_AUTOSTART_HELPER="$WORK/.autostart-helper" "$PYTHON" "$@" ); }

# Only processes actually running main.py from our working directory. Matching
# on the command line alone would also hit a shell that happens to be sitting in
# that directory, which we would then kill.
display_pids() {
    local p a0 a1
    for p in $(pgrep -f "main\.py" 2>/dev/null); do
        [ "$p" = "$$" ] && continue
        [ -r "/proc/$p/cmdline" ] || continue
        [ "$(readlink -f "/proc/$p/cwd" 2>/dev/null)" = "$(readlink -f "$WORK")" ] || continue
        a0=$(tr '\0' '\n' < "/proc/$p/cmdline" 2>/dev/null | sed -n 1p)
        a1=$(tr '\0' '\n' < "/proc/$p/cmdline" 2>/dev/null | sed -n 2p)
        # Basename, not substring: our own shim is called ".python" and would
        # otherwise match, so a launch would kill the process doing the launching.
        case "${a0##*/}" in python*) ;; *) continue ;; esac
        case "$a1" in main.py|*/main.py) ;; *) continue ;; esac
        printf '%s ' "$p"
    done
}

stop_display() {
    local pids; pids="$(display_pids)"
    [ -z "$pids" ] && return 0
    # shellcheck disable=SC2086
    kill $pids 2>/dev/null || true
    sleep 2
    pids="$(display_pids)"
    if [ -n "$pids" ]; then
        # shellcheck disable=SC2086
        kill -9 $pids 2>/dev/null || true
    fi
    return 0
}

# Only one window of a given kind. The lock fd survives into the exec'd process
# and is released by the kernel even if that process is killed.
run_once() { # run_once <lockname> <busy-message> <script> [args...]
    local lock="$WORK/.$1.lock" busy="$2"; shift 2
    if command -v flock >/dev/null 2>&1; then
        exec 8>"$lock" || true
        if ! flock -n 8; then
            note "Turing Smart Screen" "$busy"
            exit 0
        fi
    fi
    run "$@"
}

current_theme() {
    sed -n 's/^[[:space:]]*THEME:[[:space:]]*//p' "$WORK/config.yaml" 2>/dev/null | head -1 | tr -d "\"'\r"
}

materialize_theme() { # make one theme writable, on demand
    local target="$WORK/res/themes/$1" real
    if [ -L "$target" ]; then
        real="$(readlink -f "$target")"
        rm -f "$target"
        cp -rL "$real" "$target"
        chmod -R u+w "$target"
    fi
}

pick_theme() {
    local current args=() t
    current="$(current_theme)"
    if ! command -v zenity >/dev/null 2>&1; then printf '%s' "$current"; return 0; fi
    [ -n "$current" ] && args+=(TRUE "$current" "current")
    while IFS= read -r t; do
        [ "$t" = "$current" ] && continue
        args+=(FALSE "$t" "")
    done < <(find "$WORK/res/themes" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null | sort -f)
    [ ${#args[@]} -eq 0 ] && return 0
    [ -z "$current" ] && args[0]=TRUE
    zenity --list --radiolist --title="Turing Theme Editor" \
        --text="Which theme do you want to edit?" \
        --column="" --column="Theme" --column="" \
        --height=520 --width=460 "${args[@]}" 2>/dev/null || true
}

edit_theme() {
    local theme="${1:-}"
    if [ -z "$theme" ]; then theme="$(pick_theme)"; fi
    if [ -z "$theme" ]; then exit 0; fi
    materialize_theme "$theme"
    run_once themeeditor "The theme editor is already open.\n\nCheck your other windows or workspaces." theme-editor.py "$theme"
}

# --- entry points ----------------------------------------------------------

case "${1:-}" in
    ""|--config|--configure)
        # Clicking the app lands here: the settings window, every time.
        if command -v flock >/dev/null 2>&1; then
            exec 8>"$WORK/.configure.lock" || true
            if ! flock -n 8; then
                note "Turing Smart Screen" "The settings window is already open.\n\nCheck your other windows or workspaces."
                exit 0
            fi
        fi
        run_wait configure.py || true ;;
    --theme-editor)
        shift; edit_theme "${1:-}" ;;
    --display|--run)
        shift
        stop_display
        cd "$WORK"
        if command -v flock >/dev/null 2>&1; then
            exec 9>"$WORK/.display.lock" || true
            flock -w 5 9 || { echo "Another display is still holding the lock." >&2; exit 1; }
        fi
        exec "$PYTHON" main.py ;;
    --stop)
        stop_display; echo "display stopped" ;;
    --autostart)
        case "${2:-status}" in
            on|enable)   autostart_on ;;
            off|disable) autostart_off "" ;;
            *)           autostart_status ;;
        esac ;;
    --where)
        echo "image:    $HERE"; echo "workdir:  $WORK"; echo "version:  $VERSION" ;;
    -h|--help)
        cat <<HELP
Turing Smart Screen $VERSION (AppImage)

  (no arguments)      open the configuration window
                        - "Save and run" starts the display
                        - "Edit theme" opens the theme editor
  --theme-editor [T]  open the theme editor directly
  --display           start the display
  --stop              stop a running display
  --autostart on      start the display automatically at login
  --autostart off     stop doing that
  --autostart         show whether autostart is enabled

You are asked once, after your first configuration, whether to start at login.
  --where             show where settings are stored
  --help              this message

Only one display, one configuration window and one theme editor can run at a
time. Settings live in $WORK and survive replacing the AppImage.
HELP
        ;;
    *)
        stop_display
        cd "$WORK"
        exec "$PYTHON" main.py "$@" ;;
esac
